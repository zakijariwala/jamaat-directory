---
// Inline SVG icons — no icon web-font. Robust in in-app browsers (WhatsApp /
// Instagram WebViews), offline-safe, and tiny. Stroke-based 24x24 set; state
// (available / muted) is conveyed by colour + opacity per the design.
//
// Decorative by default (aria-hidden). Pass `label` to expose to screen readers.
interface Props {
  name: string;
  size?: number; // px; default 24
  class?: string;
  label?: string;
  fill?: boolean; // accepted for call-site compatibility; visuals use colour
}
const { name, size = 24, class: cls = '', label } = Astro.props;

