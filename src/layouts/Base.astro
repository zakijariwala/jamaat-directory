---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Community Directory',
  description = 'Contacts and facilities in jamaats across India.',
} = Astro.props;

// Access posture (open committee decision): ship with noindex ON by default.
// Set NOINDEX="false" in the environment for the fully-public posture.
const noindex = (import.meta.env.NOINDEX ?? 'true') !== 'false';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#001e40" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Text fonts: Public Sans + JetBrains Mono (design deliverable).
         Icons are inline SVG (see components/Icon.astro) — no icon web-font. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&family=Public+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-primary focus:text-on-primary focus:px-4 focus:py-2 focus:border-rule-heavy focus:border-on-background"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
