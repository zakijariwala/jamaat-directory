---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { TURNSTILE_SITE_KEY, CONTRIBUTE_GUIDE_URL } from '../lib/config';

// Brutalist "field-manual" container: hard 2px border, square, flat surface.
const card = 'border-2 border-on-background rounded-none p-5 md:p-6 bg-surface mb-6';
const field =
  'w-full h-12 px-4 rounded-none bg-surface border-2 border-on-background text-body-lg font-body-lg placeholder:text-on-surface-variant focus:outline-none focus:border-primary transition-colors';
const label = 'block text-label-caps font-label-caps uppercase text-on-background mb-1';
const section = 'text-headline-md font-headline-md uppercase border-b-2 border-on-background pb-2 mb-4';

// Closed-set option lists for the dropdowns. States/UTs feed the free-text
// `state` column; a moderator sets the coarse `region` enum later. Roles are
// suggestions (datalist), so a custom title still works.
const INDIAN_STATES = [
  'Andhra Pradesh', 'Arunachal Pradesh', 'Assam', 'Bihar', 'Chhattisgarh', 'Goa',
  'Gujarat', 'Haryana', 'Himachal Pradesh', 'Jharkhand', 'Karnataka', 'Kerala',
  'Madhya Pradesh', 'Maharashtra', 'Manipur', 'Meghalaya', 'Mizoram', 'Nagaland',
  'Odisha', 'Punjab', 'Rajasthan', 'Sikkim', 'Tamil Nadu', 'Telangana', 'Tripura',
  'Uttar Pradesh', 'Uttarakhand', 'West Bengal',
];
const INDIAN_UTS = [
  'Andaman and Nicobar Islands', 'Chandigarh',
  'Dadra and Nagar Haveli and Daman and Diu', 'Delhi', 'Jammu and Kashmir',
  'Ladakh', 'Lakshadweep', 'Puducherry',
];
const CONTACT_ROLES = [
  'President', 'Vice President', 'Secretary', 'Joint Secretary', 'Treasurer',
  'Trustee', 'Committee Member', 'Imam-e-Jamaat', 'Aalim / Sheikh',
  'Youth Wing', 'Ladies Wing', 'Education / Madrasah', 'Relief / Welfare',
  'Volunteer',
];
const CHARGES = [
  { value: 'free', label: 'Free' },
  { value: 'donation', label: 'Donation' },
  { value: 'paid', label: 'Paid' },
];
// Suggestions for the languages field (datalist, not a hard list — a person can
// speak several, so it stays free text and takes a comma-separated list).
// Community-relevant languages first, then the broad national set.
const LANGUAGES = [
  'Gujarati', 'Kutchi', 'Urdu', 'Hindi', 'English', 'Marathi', 'Sindhi',
  'Memoni', 'Bengali', 'Tamil', 'Telugu', 'Kannada', 'Malayalam', 'Punjabi',
  'Konkani', 'Odia', 'Assamese', 'Kashmiri',
];
const BEST_TIMES = ['Morning', 'Afternoon', 'Evening after 6pm', 'Anytime'];
const WHATSAPP_OPTS = ['Yes', 'No', 'Not sure'];
// Facility feature chips (masjid / musafir khana). Stored in facilities[].
const FEATURES = ["Wuzu", "Ladies' section", 'Parking', 'Ziyarat', 'Wheelchair access', 'Langar or food'];
// Hotel / restaurant attributes — also stored as chips in facilities[].
const PRICE_BANDS = ['Budget', 'Mid-range', 'Higher-end'];
const HALAL_OPTS = ['Strictly Halal', 'Halal options available', 'Not sure'];
// Private moderation-trust context (stored in the contact's provenance note).
const HOW_KNOWN = [
  'Family or close friend', 'Met while travelling', 'Through jamaat work',
  'Business or professional', "I don't know them personally — heard from someone else",
];
const KNOWS = ["Yes, I've told them", 'Not yet'];
const HELP_OPTIONS = [
  'Accommodation / musafir khana', 'Local transport', 'Majlis & programme timings',
  'Directions & getting around', 'Food / meals', 'Ziyarat guidance',
  'Emergency / urgent help', 'General guidance',
];
---

<Base title="Contribute — KSIJ Travel Directory">
  <header
    class="fixed top-0 left-0 w-full z-50 flex items-center px-margin-mobile md:px-margin-desktop h-[56px] bg-primary text-on-primary border-b-[2px] border-on-background"
  >
    <div class="flex items-center gap-3 w-full max-w-3xl mx-auto">
      <a href="/" aria-label="Back to directory" class="text-on-primary p-1 -ml-1 hover:opacity-80"><Icon name="arrow_back" /></a>
      <h1 class="text-headline-md font-headline-md uppercase">Add to the directory</h1>
    </div>
  </header>

  <main id="main" class="pt-[72px] pb-24 px-margin-mobile md:px-margin-desktop max-w-3xl mx-auto">
    <p class="text-body-lg font-body-lg mb-2">
      Submit a jamaat contact or facility. Every entry is reviewed by a moderator before it appears — nothing is published automatically.
    </p>
    <p class="font-data-mono text-data-mono text-on-surface-variant uppercase mb-4">
      Phone numbers are never shown publicly. They are revealed one at a time, on request.
    </p>

    <a
      href={CONTRIBUTE_GUIDE_URL}
      class="flex items-center justify-between gap-3 border-2 border-dashed border-on-background rounded-none bg-surface-container-low px-4 py-3 mb-6 hover:bg-surface-variant transition-colors"
    >
      <span class="flex items-center gap-3">
        <Icon name="menu_book" size={20} class="text-primary shrink-0" />
        <span class="font-data-mono text-data-mono uppercase">New here? Read how to fill this form (and watch the video)</span>
      </span>
      <Icon name="arrow_back" size={18} class="rotate-180 shrink-0 text-on-surface-variant" />
    </a>

    <form id="contribute-form" class="flex flex-col">
      <div class={card}>
      <h2 class={section}>City / Jamaat</h2>
      <div class="flex flex-col gap-4">
        <div><label class={label} for="c-name">City or town *</label><input id="c-name" name="city_name" required class={field} /></div>
        <div><label class={label} for="c-jamaat">Jamaat name</label><input id="c-jamaat" name="jamaat_name" class={field} /></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class={label} for="c-state">State / union territory</label>
            <select id="c-state" name="state" class={field}>
              <option value="">—</option>
              <optgroup label="States">
                {INDIAN_STATES.map((s) => <option value={s}>{s}</option>)}
              </optgroup>
              <optgroup label="Union Territories">
                {INDIAN_UTS.map((s) => <option value={s}>{s}</option>)}
              </optgroup>
            </select>
          </div>
          <div><label class={label} for="c-rail">Nearest rail</label><input id="c-rail" name="nearest_rail" class={field} /></div>
        </div>
        <div><label class={label} for="c-air">Nearest airport</label><input id="c-air" name="nearest_air" class={field} /></div>
      </div>
      </div>

      <div class={card}>
      <h2 class={section}>Contact</h2>
      <div class="flex flex-col gap-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div><label class={label} for="ct-name">Full name</label><input id="ct-name" name="ct_name" class={field} /></div>
          <div><label class={label} for="ct-phone">Phone (with country code)</label><input id="ct-phone" name="ct_phone" inputmode="tel" class={field} /></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class={label} for="ct-role">Role</label>
            <select id="ct-role" class={field}>
              <option value="">—</option>
              {CONTACT_ROLES.map((r) => <option value={r}>{r}</option>)}
            </select>
          </div>
          <div>
            <label class={label} for="ct-helps">What can they help with?</label>
            <select id="ct-helps" class={field}>
              <option value="">—</option>
              {HELP_OPTIONS.map((h) => <option value={h}>{h}</option>)}
            </select>
          </div>
        </div>
        <div>
          <label class={label}>Languages</label>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
            {LANGUAGES.map((l) => (
              <label class="flex items-center gap-2 text-body-lg cursor-pointer"><input type="checkbox" class="ct-lang w-5 h-5 accent-primary shrink-0" value={l} /> {l}</label>
            ))}
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class={label} for="ct-best">Best time to call</label>
            <select id="ct-best" class={field}>
              <option value="">—</option>
              {BEST_TIMES.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div>
            <label class={label} for="ct-wa">On WhatsApp?</label>
            <select id="ct-wa" class={field}>
              <option value="">—</option>
              {WHATSAPP_OPTS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class={label} for="ct-known">How do you know this contact?</label>
            <select id="ct-known" class={field}>
              <option value="">—</option>
              {HOW_KNOWN.map((h) => <option value={h}>{h}</option>)}
            </select>
          </div>
          <div>
            <label class={label} for="ct-knows">Do they know you're submitting?</label>
            <select id="ct-knows" class={field}>
              <option value="">—</option>
              {KNOWS.map((k) => <option value={k}>{k}</option>)}
            </select>
          </div>
        </div>
        <div class="rounded-none bg-surface-container border-2 border-on-background p-4 flex flex-col gap-3">
          <p class="text-label-caps font-label-caps uppercase text-on-background">Permission — tick one if you add a contact</p>
          <label class="flex items-start gap-3 text-body-lg cursor-pointer"><input type="checkbox" id="ct-self" class="w-5 h-5 mt-1 accent-primary shrink-0" /> These are my own details</label>
          <label class="flex items-start gap-3 text-body-lg cursor-pointer"><input type="checkbox" id="ct-consent" class="w-5 h-5 mt-1 accent-primary shrink-0" /> I have this person's permission to list their name and number in a public directory</label>
        </div>
      </div>
      </div>

      <div class={card}>
      <h2 class={section}>Facility <span class="text-body-sm normal-case font-normal text-on-surface-variant">(optional)</span></h2>
      <div class="flex flex-col gap-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class={label} for="f-kind">Type</label>
            <select id="f-kind" class={field}>
              <option value="">—</option>
              <option value="masjid">Masjid / imambargah</option>
              <option value="musafir_khana">Musafir khana</option>
              <option value="hotel">Hotel</option>
              <option value="restaurant">Restaurant</option>
            </select>
          </div>
          <div><label class={label} for="f-name">Name</label><input id="f-name" name="f_name" class={field} /></div>
        </div>
        <div><label class={label} for="f-address">Address</label><input id="f-address" name="f_address" class={field} /></div>
        <div><label class={label} for="f-maps">Google Maps link</label><input id="f-maps" name="f_maps" class={field} /></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div><label class={label} for="f-timings">Timings</label><input id="f-timings" name="f_timings" class={field} /></div>
          <div>
            <label class={label} for="f-charges">Charges</label>
            <select id="f-charges" name="f_charges" class={field}>
              <option value="">—</option>
              {CHARGES.map((c) => <option value={c.value}>{c.label}</option>)}
            </select>
          </div>
        </div>
        <div>
          <label class={label}>Features (masjid / musafir khana)</label>
          <div class="grid grid-cols-2 gap-2">
            {FEATURES.map((f) => (
              <label class="flex items-center gap-2 text-body-lg cursor-pointer"><input type="checkbox" class="f-feature w-5 h-5 accent-primary shrink-0" value={f} /> {f}</label>
            ))}
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class={label} for="f-price">Price band (hotel / restaurant)</label>
            <select id="f-price" class={field}>
              <option value="">—</option>
              {PRICE_BANDS.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>
          <div>
            <label class={label} for="f-halal">Halal (hotel / restaurant)</label>
            <select id="f-halal" class={field}>
              <option value="">—</option>
              {HALAL_OPTS.map((h) => <option value={h}>{h}</option>)}
            </select>
          </div>
        </div>
      </div>
      </div>

      {TURNSTILE_SITE_KEY && (
        <div class="cf-turnstile mb-4" data-sitekey={TURNSTILE_SITE_KEY}></div>
      )}

      <p id="form-error" class="hidden text-error font-data-mono text-data-mono mb-4" role="alert"></p>

      <button
        type="submit"
        id="submit-btn"
        class="w-full bg-secondary text-on-secondary text-label-caps font-label-caps uppercase tracking-wider py-4 px-6 border-2 border-on-background rounded-none shadow-[4px_4px_0px_rgba(28,27,27,1)] hover:shadow-[2px_2px_0px_rgba(28,27,27,1)] hover:translate-x-[2px] hover:translate-y-[2px] transition-transform active:scale-95"
      >
        Submit for review
      </button>
    </form>

    <div id="thanks" class="hidden text-center py-16">
      <Icon name="check" size={48} class="text-primary mx-auto" label="Submitted" />
      <p class="text-headline-md font-headline-md uppercase mt-4">Thank you</p>
      <p class="text-body-lg font-body-lg mt-2">Your submission is pending review. <a href="/" class="text-primary underline">Back to directory</a></p>
    </div>
  </main>

  {TURNSTILE_SITE_KEY && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <script>
    const form = document.getElementById('contribute-form') as HTMLFormElement | null;
    const errEl = document.getElementById('form-error');
    const thanks = document.getElementById('thanks');
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    // Pre-fill the city from ?city=
    const city = new URLSearchParams(location.search).get('city');
    if (city) (document.getElementById('c-name') as HTMLInputElement).value = city;

    const val = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() ?? '';
    const checked = (id: string) => (document.getElementById(id) as HTMLInputElement)?.checked ?? false;

    function showError(msg: string) {
      if (!errEl) return;
      errEl.textContent = msg;
      errEl.classList.remove('hidden');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl?.classList.add('hidden');

      const ctName = val('ct-name');
      const ctPhone = val('ct-phone');
      const fKind = val('f-kind');
      const fName = val('f-name');

      if (!val('c-name')) return showError('City or town is required.');
      if (!ctName && !fName) return showError('Add at least one contact or one facility.');
      if (ctName && !ctPhone) return showError('A contact needs a phone number.');
      if (ctName && ctPhone && !checked('ct-self') && !checked('ct-consent')) {
        return showError('For a contact, tick "my own details" or confirm you have their permission.');
      }

      const payload: any = {
        city: {
          name: val('c-name'),
          jamaat_name: val('c-jamaat'),
          state: val('c-state'),
          nearest_rail: val('c-rail'),
          nearest_air: val('c-air'),
        },
        contacts: [],
        facilities: [],
      };
      if (ctName && ctPhone) {
        payload.contacts.push({
          name: ctName, phone: ctPhone, whatsapp: val('ct-wa') === 'Yes',
          role: val('ct-role'), helps_with: val('ct-helps'),
          languages: Array.from(document.querySelectorAll<HTMLInputElement>('.ct-lang:checked')).map((el) => el.value).join(', '),
          best_time: val('ct-best'),
          how_known: val('ct-known'), knows: val('ct-knows'),
          self: checked('ct-self'), consent: checked('ct-consent'),
        });
      }
      if (fKind && fName) {
        const chips = Array.from(document.querySelectorAll<HTMLInputElement>('.f-feature:checked')).map((el) => el.value);
        const price = val('f-price');
        const halal = val('f-halal');
        if (price) chips.push(price);
        if (halal) chips.push(halal);
        payload.facilities.push({
          kind: fKind, name: fName, address: val('f-address'),
          maps_url: val('f-maps'), timings: val('f-timings'),
          charges_band: val('f-charges'), facilities: chips,
        });
      }

      const token = (document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement)?.value;
      if (token) payload.cf_token = token;

      if (btn) { btn.disabled = true; btn.textContent = 'Submitting…'; }
      try {
        const res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.detail || data.error || 'Submission failed.');
        form.classList.add('hidden');
        thanks?.classList.remove('hidden');
      } catch (err) {
        showError((err as Error).message);
        if (btn) { btn.disabled = false; btn.textContent = 'Submit for review'; }
      }
    });
  </script>
</Base>
