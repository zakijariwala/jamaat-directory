---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// A plain-language explainer for the jamaat body / committee. Not the
// engineering architecture doc (that stays in docs/how-it-works.html). Prose
// follows the stop-slop rules: active voice, human subjects, specifics, "you",
// no em dashes, no adverb padding.

const h2 = 'text-headline-md font-headline-md uppercase tracking-tight border-b-[2px] border-on-background pb-stack-compact mb-stack-regular';
const lead = 'text-body-lg font-body-lg text-on-surface-variant';

// The three-step flow, rendered as plain boxes (no diagram library).
const flow = [
  {
    icon: 'add_box',
    step: 'Step 1. You add an entry',
    body: 'You open the directory, tap Add, and fill a short form on the site. You add a contact, a masjid, a place to stay, a hotel, or a restaurant. You need no account. You install no app.',
  },
  {
    icon: 'verified',
    step: 'Step 2. A moderator approves it',
    body: 'A named jamaat volunteer reads your entry. They work in a review page on the site or in a downloaded Excel file. They mark it live. Your entry stays hidden until they do.',
  },
  {
    icon: 'travel_explore',
    step: 'Step 3. It reaches travellers',
    body: 'Your approved entry shows on the public directory. A traveller opens one link, searches a city, and finds a local contact, the masjid, and a place to stay.',
  },
];

const privacy = [
  'We never publish phone numbers in bulk. A visitor taps Show number to reveal one at a time. A bot check and rate limits guard every reveal.',
  'We list a person only with their consent. Anyone can report or remove their own entry at any time.',
  'We show only the entries a moderator marked live.',
  'The site ships unlisted for now. Google does not list it. You choose when that changes.',
];

const costs = [
  { item: 'Website and hosting (Cloudflare)', cost: '₹0 / month', note: 'The free tier covers the traffic we expect.' },
  { item: 'Contributions and moderation (in-site)', cost: '₹0 / month', note: 'The form and the review tools run on the same site.' },
  { item: 'Custom domain (optional)', cost: '~$8 to $12 / year', note: 'You pay this only for your own web address.' },
  { item: 'Extra capacity (large scale only)', cost: '~$5 / month', note: 'You skip this at launch scale.' },
];

const decisions = [
  { q: 'Access posture', d: 'Share by link only, or list the site on Google. You pick.' },
  { q: 'Moderators', d: 'Name at least two jamaat volunteers to review and approve entries.' },
  { q: 'Hotels and restaurants', d: 'Keep these sections in the first version, or start with contacts, masjids, and stays.' },
  { q: 'Web address', d: 'Choose whether you want a custom domain, and which name.' },
  { q: 'Endorsement', d: 'Give the go-ahead to launch, and set any rules about what we may list.' },
];
---

<Base
  title="How it works — KSIJ Travel Directory"
  description="A plain-language explainer of the KSIJ Travel Directory for the jamaat body: what it is, how it works, who runs it, what it costs, and what you decide."
>
  <!-- Top app bar (matches the directory) -->
  <header
    class="fixed top-0 left-0 w-full z-50 flex items-center px-margin-mobile md:px-margin-desktop h-[56px] bg-primary text-on-primary border-b-[2px] border-on-background"
  >
    <div class="flex items-center gap-4 w-full max-w-3xl mx-auto">
      <a href="/" aria-label="Back to directory" class="shrink-0 flex items-center">
        <img
          src="/logo.svg"
          alt="KSIJ"
          width="40"
          height="40"
          class="h-10 w-10 object-contain rounded-[4px]"
        />
      </a>
      <h1 class="text-headline-md font-headline-md tracking-tight uppercase flex-grow">
        How it works
      </h1>
      <a
        href="/"
        class="shrink-0 flex items-center gap-1 text-label-caps font-label-caps uppercase hover:opacity-80 transition-opacity"
      >
        <Icon name="arrow_back" size={18} />
        <span class="hidden sm:inline">Directory</span>
      </a>
    </div>
  </header>

  <main id="main" class="pt-[56px]">
    <div class="w-full max-w-3xl mx-auto px-margin-mobile md:px-margin-desktop py-8 flex flex-col gap-12">
      <!-- Intro -->
      <section>
        <p class="text-data-mono font-data-mono text-primary uppercase mb-stack-regular">
          A briefing for the jamaat body
        </p>
        <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg-mobile md:font-headline-lg uppercase tracking-tight mb-stack-regular">
          One shared link. A trusted contact in every jamaat.
        </h2>
        <p class={`${lead} mb-stack-regular`}>
          The KSIJ Travel Directory lists jamaat contacts and facilities across
          India. A traveller opens one link, searches a city, and gets a local
          contact, the masjid, and a place to stay. You install nothing. You sign
          in nowhere. We built it, and it runs today as a working prototype for you
          to review.
        </p>
        <a
          href="/ksij-directory-briefing.pdf"
          download
          class="inline-flex items-center gap-2 bg-surface-container text-on-background border-[2px] border-on-background px-5 py-3 text-label-caps font-label-caps uppercase tracking-wider hover:bg-surface-variant transition-colors"
        >
          <Icon name="download" size={18} />
          Download this briefing (PDF)
        </a>
      </section>

      <!-- The need -->
      <section>
        <h2 class={h2}>The need</h2>
        <p class={lead}>
          Our members travel to cities they do not know. To find a local contact,
          the nearest masjid, or a musafir khana, they ask around and lean on
          personal networks. Newcomers and younger travellers rarely hold those
          networks. We gather that scattered knowledge into one reference you reach
          any time. It covers every region from day one, and it treats no city as
          the default.
        </p>
      </section>

      <!-- How it works -->
      <section>
        <h2 class={h2}>How it works</h2>
        <p class={`${lead} mb-stack-regular`}>
          The system runs in three steps. You keep it current. A jamaat moderator
          keeps it trustworthy.
        </p>
        <div class="flex flex-col gap-4">
          {
            flow.map((f) => (
              <div class="flex gap-4 border-[2px] border-on-background p-4 bg-surface-container-low">
                <div class="shrink-0 text-primary">
                  <Icon name={f.icon} size={28} />
                </div>
                <div>
                  <p class="text-label-caps font-label-caps uppercase mb-stack-compact">
                    {f.step}
                  </p>
                  <p class="text-body-lg font-body-lg">{f.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Who runs it -->
      <section>
        <h2 class={h2}>Who runs it</h2>
        <p class={lead}>
          A jamaat volunteer moderates the entries. They work in a review page on
          the site or in a downloaded Excel file. They approve an entry or fix a
          typo without a developer. Cloudflare hosts the website, so you maintain no
          servers. The community adds entries, named moderators approve them, and
          the site serves itself. It asks two things of you: oversight, and the
          moderators to staff it.
        </p>
      </section>

      <!-- Privacy & safety -->
      <section>
        <h2 class={h2}>Privacy &amp; safety</h2>
        <p class={`${lead} mb-stack-regular`}>
          We protected members' contact details from the first design sketch. These
          rules hold:
        </p>
        <ul class="flex flex-col gap-stack-regular">
          {
            privacy.map((p) => (
              <li class="flex gap-3 text-body-lg font-body-lg">
                <span class="shrink-0 text-primary mt-1">
                  <Icon name="verified" size={20} />
                </span>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Costs -->
      <section>
        <h2 class={h2}>What it costs</h2>
        <p class="text-headline-md font-headline-md text-primary mb-stack-regular">
          ₹0 / month to run at launch scale.
        </p>
        <p class={`${lead} mb-stack-regular`}>
          The system sits inside the free tiers of Cloudflare. You spend money on
          one optional thing: a custom web address.
        </p>
        <div class="border-[2px] border-on-background divide-y-[1px] divide-outline-variant">
          {
            costs.map((c) => (
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 p-3">
                <div class="min-w-0">
                  <p class="text-body-lg font-body-lg">{c.item}</p>
                  <p class="text-data-mono font-data-mono text-on-surface-variant">{c.note}</p>
                </div>
                <p class="text-label-caps font-label-caps uppercase text-primary shrink-0">
                  {c.cost}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Status -->
      <section>
        <h2 class={h2}>Where it stands</h2>
        <p class={lead}>
          You can open the directory today. We loaded it with sample cities, so you
          search it and use it now. Two tasks remain. You add real jamaat data. You
          switch on live community contributions. The decisions below unlock both.
        </p>
      </section>

      <!-- Decisions -->
      <section>
        <h2 class={h2}>What we need you to decide</h2>
        <ol class="flex flex-col gap-4">
          {
            decisions.map((d, i) => (
              <li class="flex gap-4 border-l-[2px] border-primary pl-4">
                <span class="text-data-mono font-data-mono text-primary shrink-0">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <p class="text-label-caps font-label-caps uppercase mb-stack-compact">{d.q}</p>
                  <p class="text-body-lg font-body-lg text-on-surface-variant">{d.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Back to directory -->
      <section class="border-t-[2px] border-on-background pt-6">
        <a
          href="/"
          class="group relative inline-flex w-full sm:w-auto"
        >
          <span class="absolute inset-0 bg-on-background translate-x-1 translate-y-1 transition-transform group-hover:translate-x-0 group-hover:translate-y-0"></span>
          <span
            class="relative w-full flex items-center justify-center gap-2 bg-primary border-[2px] border-on-background px-6 py-4 text-on-primary text-label-caps font-label-caps uppercase tracking-wider"
          >
            <Icon name="travel_explore" size={18} />
            Open the directory
          </span>
        </a>
      </section>
    </div>
  </main>
</Base>
