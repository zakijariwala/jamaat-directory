---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// A plain-language explainer for the jamaat body / committee — NOT the
// engineering architecture doc (that stays in docs/how-it-works.html). Purpose:
// let a non-technical governing body understand the project and endorse a
// launch. No commands, no code, no jargon.

// Section heading style shared across the page.
const h2 = 'text-headline-md font-headline-md uppercase tracking-tight border-b-[2px] border-on-background pb-stack-compact mb-stack-regular';
const lead = 'text-body-lg font-body-lg text-on-surface-variant';

// The three-step flow, rendered as plain boxes (no diagram library).
const flow = [
  {
    icon: 'add_box',
    step: '1 — Anyone contributes',
    body: 'A community member fills in a short Google Form to add a contact, a masjid, a place to stay, or to report/remove an entry. No account, no app.',
  },
  {
    icon: 'verified',
    step: '2 — A moderator reviews',
    body: 'A named jamaat volunteer checks the entry in a familiar Google Sheet — the same as reviewing a spreadsheet. Nothing goes live until they approve it. No developer is needed.',
  },
  {
    icon: 'travel_explore',
    step: '3 — It appears on the website',
    body: 'Approved entries show up on the public directory. A traveller opens one link, searches a city, and finds a local contact, the masjid, and somewhere to stay.',
  },
];

const privacy = [
  'Phone numbers are never published in bulk. They are shown one at a time, only when a visitor taps “Show number”, protected by a bot check and rate limiting.',
  'A contact is only listed with the person’s consent. Anyone can report or remove their own entry at any time.',
  'Only entries a moderator has marked “live” are ever shown.',
  'The site currently ships unlisted — it is not found on Google — until the body decides the access posture.',
];

const costs = [
  { item: 'Website + hosting (Cloudflare)', cost: '₹0 / month', note: 'Free tier covers the expected traffic.' },
  { item: 'Contributions (Google Form + Sheet)', cost: '₹0 / month', note: 'Runs on an ordinary Google account.' },
  { item: 'Custom domain (optional)', cost: '~$8–12 / year', note: 'Only if we want our own web address.' },
  { item: 'Extra capacity (only if very large)', cost: '~$5 / month', note: 'Not needed at launch scale.' },
];

const decisions = [
  { q: 'Access posture', d: 'Unlisted (share by link only) or fully public (findable on Google)?' },
  { q: 'Moderators', d: 'Name at least two jamaat volunteers to review and approve entries.' },
  { q: 'Hotels & restaurants', d: 'Keep these sections in the first version, or contacts + masjids + stay only?' },
  { q: 'Web address', d: 'Do we want a custom domain name, and if so, which?' },
  { q: 'Endorsement', d: 'Formal go-ahead to launch, and any rules about what may be listed.' },
];
---

<Base
  title="How it works — KSIJ Travel Directory"
  description="A plain-language explainer of the KSIJ Travel Directory for the jamaat body: what it is, how it works, who runs it, what it costs, and what we need you to decide."
>
  <!-- Top app bar (matches the directory) -->
  <header
    class="fixed top-0 left-0 w-full z-50 flex items-center px-margin-mobile md:px-margin-desktop h-[56px] bg-primary text-on-primary border-b-[2px] border-on-background"
  >
    <div class="flex items-center gap-4 w-full max-w-3xl mx-auto">
      <a href="/" aria-label="Back to directory" class="shrink-0 flex items-center">
        <img
          src="/logo.svg"
          alt="KSIJ"
          width="40"
          height="40"
          class="h-10 w-10 object-contain rounded-[4px]"
        />
      </a>
      <h1 class="text-headline-md font-headline-md tracking-tight uppercase flex-grow">
        How it works
      </h1>
      <a
        href="/"
        class="shrink-0 flex items-center gap-1 text-label-caps font-label-caps uppercase hover:opacity-80 transition-opacity"
      >
        <Icon name="arrow_back" size={18} />
        <span class="hidden sm:inline">Directory</span>
      </a>
    </div>
  </header>

  <main id="main" class="pt-[56px]">
    <div class="w-full max-w-3xl mx-auto px-margin-mobile md:px-margin-desktop py-8 flex flex-col gap-12">
      <!-- Intro -->
      <section>
        <p class="text-data-mono font-data-mono text-primary uppercase mb-stack-regular">
          A briefing for the jamaat body
        </p>
        <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg-mobile md:font-headline-lg uppercase tracking-tight mb-stack-regular">
          One shared link. A trusted contact in every jamaat.
        </h2>
        <p class={`${lead} mb-stack-regular`}>
          The KSIJ Travel Directory is a simple public web directory of jamaat
          contacts and facilities across India. A traveller opens one link,
          searches a city, and gets a local contact, the masjid, and somewhere to
          stay. No app to install, no login. It is already built and running as a
          working prototype for the body to review.
        </p>
        <a
          href="/ksij-directory-briefing.pdf"
          download
          class="inline-flex items-center gap-2 bg-surface-container text-on-background border-[2px] border-on-background px-5 py-3 text-label-caps font-label-caps uppercase tracking-wider hover:bg-surface-variant transition-colors"
        >
          <Icon name="download" size={18} />
          Download this briefing (PDF)
        </a>
      </section>

      <!-- The need -->
      <section>
        <h2 class={h2}>The need</h2>
        <p class={lead}>
          When our members travel to an unfamiliar city, finding a reliable local
          jamaat contact, the nearest masjid, or a musafir khana to stay in still
          depends on word-of-mouth and personal networks. Newcomers and younger
          travellers often have neither. This directory turns that scattered
          knowledge into one trusted, always-available reference — pan-India from
          day one, with no city treated as the default.
        </p>
      </section>

      <!-- How it works -->
      <section>
        <h2 class={h2}>How it works</h2>
        <p class={`${lead} mb-stack-regular`}>
          The whole system is three plain steps. The community keeps it up to
          date; a jamaat moderator keeps it trustworthy.
        </p>
        <div class="flex flex-col gap-4">
          {
            flow.map((f) => (
              <div class="flex gap-4 border-[2px] border-on-background p-4 bg-surface-container-low">
                <div class="shrink-0 text-primary">
                  <Icon name={f.icon} size={28} />
                </div>
                <div>
                  <p class="text-label-caps font-label-caps uppercase mb-stack-compact">
                    {f.step}
                  </p>
                  <p class="text-body-lg font-body-lg">{f.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Who runs it -->
      <section>
        <h2 class={h2}>Who runs it</h2>
        <p class={lead}>
          Day-to-day moderation happens in an ordinary Google Sheet, so a
          non-technical jamaat volunteer can approve an entry or fix a typo without
          a developer. The website itself is hosted on Cloudflare and needs no
          servers to maintain. In short: the community contributes, named
          moderators approve, and the site runs itself. All it needs from the body
          is oversight — and the moderators to staff it.
        </p>
      </section>

      <!-- Privacy & safety -->
      <section>
        <h2 class={h2}>Privacy &amp; safety</h2>
        <p class={`${lead} mb-stack-regular`}>
          Protecting members’ contact details was a first-class design goal, built
          into the system — not an afterthought.
        </p>
        <ul class="flex flex-col gap-stack-regular">
          {
            privacy.map((p) => (
              <li class="flex gap-3 text-body-lg font-body-lg">
                <span class="shrink-0 text-primary mt-1">
                  <Icon name="verified" size={20} />
                </span>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Costs -->
      <section>
        <h2 class={h2}>What it costs</h2>
        <p class="text-headline-md font-headline-md text-primary mb-stack-regular">
          ₹0 / month to run at launch scale.
        </p>
        <p class={`${lead} mb-stack-regular`}>
          The system is designed to sit inside the free tiers of Cloudflare and
          Google. The only optional spending is a custom web address.
        </p>
        <div class="border-[2px] border-on-background divide-y-[1px] divide-outline-variant">
          {
            costs.map((c) => (
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 p-3">
                <div class="min-w-0">
                  <p class="text-body-lg font-body-lg">{c.item}</p>
                  <p class="text-data-mono font-data-mono text-on-surface-variant">{c.note}</p>
                </div>
                <p class="text-label-caps font-label-caps uppercase text-primary shrink-0">
                  {c.cost}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Status -->
      <section>
        <h2 class={h2}>Where it stands</h2>
        <p class={lead}>
          The directory is fully built and deployed as a working prototype, loaded
          with sample cities so the body can see and use it today. What remains is
          adding real jamaat data and switching on live community contributions —
          which is exactly what the decisions below unlock.
        </p>
      </section>

      <!-- Decisions -->
      <section>
        <h2 class={h2}>What we need you to decide</h2>
        <ol class="flex flex-col gap-4">
          {
            decisions.map((d, i) => (
              <li class="flex gap-4 border-l-[2px] border-primary pl-4">
                <span class="text-data-mono font-data-mono text-primary shrink-0">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <p class="text-label-caps font-label-caps uppercase mb-stack-compact">{d.q}</p>
                  <p class="text-body-lg font-body-lg text-on-surface-variant">{d.d}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Back to directory -->
      <section class="border-t-[2px] border-on-background pt-6">
        <a
          href="/"
          class="group relative inline-flex w-full sm:w-auto"
        >
          <span class="absolute inset-0 bg-on-background translate-x-1 translate-y-1 transition-transform group-hover:translate-x-0 group-hover:translate-y-0"></span>
          <span
            class="relative w-full flex items-center justify-center gap-2 bg-primary border-[2px] border-on-background px-6 py-4 text-on-primary text-label-caps font-label-caps uppercase tracking-wider"
          >
            <Icon name="travel_explore" size={18} />
            Open the directory
          </span>
        </a>
      </section>
    </div>
  </main>
</Base>
