{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "functions", "scripts", "test", "workers", "env.d.ts"],
  "exclude": ["dist", ".wrangler", "node_modules"]
}
